# .env.example — copy to .env and fill in real values. NEVER commit the real .env.
# The real .env is git-ignored. Keep a copy in a password manager / secure store.
# A full rebuild needs THIS repo + a populated .env.

# ---- gluetun (compose: gluetun stack) ----
# Mullvad WireGuard credentials (regenerate in the Mullvad account dashboard).
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=          # e.g. 10.x.x.x/32  (VPN-assigned address; mildly sensitive)

# ---- Soularr config.ini + slskd.yml (sanitized copies in configs/) ----
# These are NOT compose env vars — they live inside the app config files.
# Listed here so the full secret inventory is in one place; substitute them
# back into the config files on restore (see SETUP.md).
LIDARR_API_KEY=              # Lidarr Settings -> General -> API Key
SLSKD_API_KEY=              # slskd web.authentication.api_keys key (also used by Soularr [Slskd] api_key)
SLSKD_WEB_USERNAME=
SLSKD_WEB_PASSWORD=
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=

# ---- Host ----
HOST_IP=                    # LAN IP the apps use to reach each other, e.g. 192.168.1.103
                            # (see GOTCHAS.md re: why it's the host IP and not localhost)

# ---- Other app API keys (embedded in SQLite DBs, NOT in this repo) ----
# Prowlarr, Radarr, Sonarr each have their own API key inside their database.
# These are captured by the separate physical-media config backup, not here.
# If rebuilding from scratch, they are generated fresh by each app on first run.
